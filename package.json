{
  "name": "party-games-night",
  "version": "0.3.0",
  "description": "Вечер игр: «Чужой», «Снайпер», «Крокодил», «Телепатия» — party-игры для ТВ и телефонов в одной Wi-Fi сети",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check-scenes.js",
    "build:exe": "npx --yes @yao-pkg/pkg@6 . --targets node22-win-x64 --output dist/Vecher-igr.exe",
    "test": "node --test test/chests.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "data/**/*",
      "node_modules/socket.io/client-dist/*"
    ],
    "outputPath": "dist"
  }
}
